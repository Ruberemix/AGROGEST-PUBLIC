# =====================================================================
#  AgroGest - variables de entorno de ejemplo
#  1. Copie este archivo como ".env" en la carpeta del proyecto.
#  2. Complete los valores. El archivo .env NO se sube a Git.
#  (También puede definirlas como variables de entorno del sistema.)
# =====================================================================

# ---------- Base de datos MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agrogest_db
DB_USER=root
DB_PASSWORD=

# ---------- Administrador inicial ----------
# Se crea solo la primera vez (si no existe ningún administrador).
# La contraseña debe tener 8-64 caracteres con mayúscula, minúscula, número y carácter especial.
AGROGEST_ADMIN_USER=admin
AGROGEST_ADMIN_PASSWORD=
AGROGEST_ADMIN_EMAIL=correo-del-administrador@gmail.com

# ---------- Correo SMTP (recuperación de contraseña) ----------
# Gmail: active la verificación en dos pasos y cree una "contraseña de aplicación"
# en https://myaccount.google.com/apppasswords (16 letras, sin espacios).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=su-correo@gmail.com
MAIL_PASSWORD=
MAIL_FROM=su-correo@gmail.com

# URL con la que se abre la aplicación (para el enlace del correo)
APP_BASE_URL=http://localhost:8080
